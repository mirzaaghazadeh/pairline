# In-app event "Carrier Tools on Your iPhone": call forwarding, call waiting, caller ID, balance, voicemail and
# signal for the Android SIM (D-082; not in 1.0.1). Read by upload-event.sh.
# Text: <locale>/{name,short_description,long_description}.txt (30, 50 and 120 characters at most).
# Images: events.html#event=carrier-tools. Retake 08-bridge-status once the Bridge tab shows the balance card.
REFERENCE_NAME="Carrier tools launch"
EVENT_TYPE=MAJOR_UPDATE
PURPOSE=APPROPRIATE_FOR_ALL_USERS
PRIORITY=NORMAL
DEEP_LINK="pairline://status"
# Set these (RFC 3339, UTC) once the carrier tools have passed the real-phone tests and shipped in an App Store version.
# An event runs at most 31 days; it can be shown up to 14 days before it starts.
PUBLISH_START=
START=
END=
