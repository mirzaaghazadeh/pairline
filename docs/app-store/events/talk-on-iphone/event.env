# In-app event "Talk on Your iPhone": call audio on the iPhone (M6). Read by upload-event.sh.
# Text: <locale>/{name,short_description,long_description}.txt (30, 50 and 120 characters at most).
# Images: events.html#event=talk-on-iphone, rendered by render.sh into out/<locale>/events/talk-on-iphone/.
REFERENCE_NAME="Talk on iPhone launch"
EVENT_TYPE=MAJOR_UPDATE
PURPOSE=APPROPRIATE_FOR_ALL_USERS
PRIORITY=HIGH
DEEP_LINK="pairline://status"
# Set these (RFC 3339, UTC) once call audio has passed the real-phone tests and shipped in an App Store version.
# An event runs at most 31 days; it can be shown up to 14 days before it starts.
PUBLISH_START=
START=
END=
