        "fa" : { "stringUnit" : { "state" : "translated", "value" : "یک پیام در پست صوتی منتظر است. Pairline را باز کنید تا با پست صوتی تماس بگیرید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bekleyen bir sesli mesaj var. Sesli mesajınızı aramak için Pairline’ı açın." } }
