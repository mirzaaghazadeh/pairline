{
  "sourceLanguage" : "en",
  "strings" : {
    "A second call can ring while you're on a call." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يمكن أن يرنّ اتصال ثانٍ وأنت في مكالمة." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A second call can ring while you're on a call." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "وقتی پشت خط هستید، تماس دوم هم می‌تواند زنگ بخورد." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bir görüşmedeyken ikinci bir arama da çalabilir." } }
      }
    },
    "A voicemail is waiting on %@. Open Pairline to call your voicemail." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "توجد رسالة في البريد الصوتي على %@. افتح Pairline للاتصال بالبريد الصوتي." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A voicemail is waiting on %@. Open Pairline to call your voicemail." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "یک پیام در پست صوتی %@ منتظر است. Pairline را باز کنید تا با پست صوتی تماس بگیرید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ üzerinde bekleyen bir sesli mesaj var. Sesli mesajınızı aramak için Pairline’ı açın." } }
      }
    },
    "A voicemail is waiting. Open Pairline to call your voicemail." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "توجد رسالة في البريد الصوتي. افتح Pairline للاتصال بالبريد الصوتي." } },
