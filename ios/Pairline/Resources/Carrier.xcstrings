    "Check balance" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "التحقق من الرصيد" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Check balance" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "بررسی موجودی" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bakiyeyi sorgula" } }
      }
    },
    "Checked %@ ago" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم التحقق قبل %@" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Checked %@ ago" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "%@ پیش بررسی شد" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ önce sorgulandı" } }
      }
    },
    "Choose a balance code first: run it under Calls › USSD codes and turn on “Use as balance code”." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر رمز الرصيد أولًا: شغّله من المكالمات › رموز USSD وفعّل «استخدامه رمزًا للرصيد»." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a balance code first: run it under Calls › USSD codes and turn on “Use as balance code”." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "اول کد موجودی را انتخاب کنید: آن را در تماس‌ها › کدهای USSD اجرا کنید و «استفاده به‌عنوان کد موجودی» را روشن کنید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Önce bir bakiye kodu seçin: Aramalar › USSD kodları’nda çalıştırın ve “Bakiye kodu olarak kullan”ı açın." } }
      }
    },
    "Forward to this number" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "التحويل إلى هذا الرقم" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Forward to this number" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "انتقال به این شماره" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu numaraya yönlendir" } }
      }
    },
    "Hide my number on every call" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "إخفاء رقمي في كل المكالمات" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hide my number on every call" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "پنهان کردن شماره در همهٔ تماس‌ها" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tüm aramalarda numaramı gizle" } }
      }
    },
    "New voicemail" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "رسالة جديدة في البريد الصوتي" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "New voicemail" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "پیام جدید در پست صوتی" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yeni sesli mesaj" } }
      }
    },
    "Not checked since Pairline opened." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم يتم التحقق منذ فتح Pairline." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Not checked since Pairline opened." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "از وقتی Pairline باز شده بررسی نشده است." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Pairline açıldığından beri sorgulanmadı." } }
      }
    },
    "Number to forward to" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الرقم المراد التحويل إليه" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Number to forward to" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "شمارهٔ مقصد" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yönlendirilecek numara" } }
      }
    },
    "Send calls to another number. Your carrier may charge for forwarded calls." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "حوّل المكالمات إلى رقم آخر. قد يفرض المشغّل رسومًا على المكالمات المحوّلة." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Send calls to another number. Your carrier may charge for forwarded calls." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "تماس‌ها را به شمارهٔ دیگری بفرستید. ممکن است اپراتور برای تماس‌های منتقل‌شده هزینه بگیرد." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Aramaları başka bir numaraya gönderin. Operatörünüz yönlendirilen aramalar için ücret alabilir." } }
      }
    },
    "Show my number on every call" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "إظهار رقمي في كل المكالمات" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Show my number on every call" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "نمایش شماره در همهٔ تماس‌ها" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tüm aramalarda numaramı göster" } }
      }
    },
    "Shows its reply on the Bridge tab, with a button to check again." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يظهر ردّه في تبويب الوسيط مع زر للتحقق مجددًا." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Shows its reply on the Bridge tab, with a button to check again." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "پاسخش در زبانهٔ پل نشان داده می‌شود، با دکمه‌ای برای بررسی دوباره." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yanıtını Köprü sekmesinde, yeniden sorgulama düğmesiyle gösterir." } }
      }
    },
    "These are the standard codes for GSM carriers; not every carrier supports each of them. The carrier's reply shows here and isn't stored." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "هذه هي الرموز القياسية لمشغّلي GSM، ولا يدعمها كل مشغّل. يظهر ردّ المشغّل هنا ولا يُحفظ." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "These are the standard codes for GSM carriers; not every carrier supports each of them. The carrier's reply shows here and isn't stored." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "این‌ها کدهای استاندارد اپراتورهای GSM هستند و هر اپراتوری همهٔ آن‌ها را پشتیبانی نمی‌کند. پاسخ اپراتور اینجا نشان داده می‌شود و ذخیره نمی‌شود." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bunlar GSM operatörlerinin standart kodlarıdır; her operatör hepsini desteklemez. Operatörün yanıtı burada görünür ve saklanmaz." } }
      }
    },
    "To hide your number on one call only, touch and hold the call button on the keypad." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "لإخفاء رقمك في مكالمة واحدة فقط، المس زر الاتصال في لوحة المفاتيح مطولًا." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "To hide your number on one call only, touch and hold the call button on the keypad." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "برای پنهان کردن شماره فقط در یک تماس، دکمهٔ تماس را در صفحه‌کلید نگه دارید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Numaranızı yalnızca bir aramada gizlemek için tuş takımındaki arama düğmesine dokunup basılı tutun." } }
      }
    },
    "Turn off" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "إيقاف" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn off" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "خاموش کردن" } },
