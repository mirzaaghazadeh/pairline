    },
    "Add a picture" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "إضافة صورة" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Add a picture" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "افزودن عکس" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Resim ekle" } }
      }
    },
    "Connect to the bridge phone over Wi-Fi to open attachments." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "اتصل بالهاتف الوسيط عبر الواي فاي لفتح المرفقات." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Connect to the bridge phone over Wi-Fi to open attachments." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "برای باز کردن پیوست‌ها، از راه وای‌فای به گوشی پل وصل شوید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ekleri açmak için köprü telefona Wi-Fi üzerinden bağlanın." } }
      }
    },
    "Group message: everyone in this conversation gets it as an MMS." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "رسالة جماعية: تصل إلى كل من في هذه المحادثة كرسالة MMS." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Group message: everyone in this conversation gets it as an MMS." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "پیام گروهی: همهٔ افراد این گفتگو آن را به‌صورت MMS می‌گیرند." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Grup mesajı: bu konuşmadaki herkes bunu MMS olarak alır." } }
      }
    },
    "Not sent. Send it again." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم تُرسل. أرسلها مرة أخرى." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Not sent. Send it again." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "فرستاده نشد. دوباره بفرستید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Gönderilmedi. Yeniden gönderin." } }
      }
    },
