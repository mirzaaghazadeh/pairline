        "fa" : { "stringUnit" : { "state" : "translated", "value" : "پروتکل مودم: %@" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Modem protokolü: %@" } }
      }
    },
    "The bridge phone sent an answer this app doesn't understand. Update both apps." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "أرسل الهاتف الوسيط ردًا لا يفهمه هذا التطبيق. حدّث التطبيقين." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The bridge phone sent an answer this app doesn't understand. Update both apps." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "گوشی پل پاسخی فرستاد که این برنامه آن را نمی‌فهمد. هر دو برنامه را به‌روز کنید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Köprü telefon bu uygulamanın anlamadığı bir yanıt gönderdi. İki uygulamayı da güncelleyin." } }
