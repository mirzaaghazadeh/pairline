{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ of %lld GB" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "%@ من %lld غيغابايت" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ of %lld GB" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "%@ از %lld گیگابایت" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ / %lld GB" } }
      }
    },
    "Allow Usage access for Pairline Bridge on the Android phone: it shows a notification that leads there." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "اسمح بـ«الوصول إلى بيانات الاستخدام» لـ Pairline Bridge على هاتف أندرويد؛ يعرض إشعارًا يقودك إليه." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Usage access for Pairline Bridge on the Android phone: it shows a notification that leads there." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "روی گوشی اندرویدی «دسترسی به میزان استفاده» را برای Pairline Bridge روشن کنید؛ اعلانی آنجا شما را به آن می‌رساند." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefonda Pairline Bridge için Kullanım erişimine izin verin; oraya götüren bir bildirim gösterir." } }
      }
    },
    "Allow Usage access for Pairline Bridge on your Android phone: open the data meter here and it shows a notification there that leads to it." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "اسمح بـ«الوصول إلى بيانات الاستخدام» لـ Pairline Bridge على هاتف أندرويد: افتح عدّاد البيانات هنا فيعرض هناك إشعارًا يقودك إليه." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Usage access for Pairline Bridge on your Android phone: open the data meter here and it shows a notification there that leads to it." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "روی گوشی اندرویدی «دسترسی به میزان استفاده» را برای Pairline Bridge روشن کنید: سنجش اینترنت را اینجا باز کنید تا آنجا اعلانی نشان دهد که شما را به آن می‌رساند." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefonunuzda Pairline Bridge için Kullanım erişimine izin verin: veri sayacını burada açın, orada sizi oraya götüren bir bildirim gösterir." } }
      }
    },
    "Android may send it a few minutes late: allow Pairline Bridge under Alarms & reminders on the Android phone for the exact minute." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "قد يرسلها أندرويد متأخرة بضع دقائق: اسمح لـ Pairline Bridge ضمن «المنبّهات والتذكيرات» على هاتف أندرويد لتُرسل في الدقيقة نفسها." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Android may send it a few minutes late: allow Pairline Bridge under Alarms & reminders on the Android phone for the exact minute." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "ممکن است اندروید آن را چند دقیقه دیرتر بفرستد: برای ارسال در همان دقیقه، روی گوشی اندرویدی Pairline Bridge را در «هشدارها و یادآوری‌ها» مجاز کنید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android bunu birkaç dakika geç gönderebilir: tam dakikasında gitmesi için Android telefonda Alarmlar ve hatırlatıcılar altında Pairline Bridge’e izin verin." } }
      }
    },
    "Cancel scheduled message" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "إلغاء الرسالة المجدولة" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel scheduled message" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "لغو پیام زمان‌بندی‌شده" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Zamanlanmış mesajı iptal et" } }
