      }
    },
    "Send later…" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "إرسال لاحقًا…" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Send later…" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "ارسال در زمان دیگر…" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sonra gönder…" } }
      }
    },
    "Show mobile data" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "عرض بيانات الجوال" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Show mobile data" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "نمایش مصرف اینترنت همراه" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Mobil veriyi göster" } }
      }
    },
    "Since %@, every SIM together." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "منذ %@، لكل الشرائح معًا." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Since %@, every SIM together." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "از %@، همهٔ سیم‌کارت‌ها با هم." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "%@ tarihinden beri, tüm SIM’ler birlikte." } }
      }
    },
    "The Android phone has used %@ of mobile data this month (%lld%% of your limit)." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "استخدم هاتف أندرويد %@ من بيانات الجوال هذا الشهر (%lld%% من حدّك)." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Android phone has used %@ of mobile data this month (%lld%% of your limit)." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "گوشی اندرویدی این ماه %@ اینترنت همراه مصرف کرده است (%lld%% سقف شما)." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefon bu ay %@ mobil veri kullandı (sınırınızın %%%lld kadarı)." } }
      }
    },
    "The Android phone isn't connected, or that notification is gone there. Reply on the Android phone instead." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "هاتف أندرويد غير متصل، أو أن ذلك الإشعار لم يعد موجودًا هناك. ردّ من هاتف أندرويد بدلًا من ذلك." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Android phone isn't connected, or that notification is gone there. Reply on the Android phone instead." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "گوشی اندرویدی وصل نیست، یا آن اعلان دیگر آنجا نیست. به‌جای آن از گوشی اندرویدی پاسخ دهید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefon bağlı değil ya da o bildirim artık orada yok. Bunun yerine Android telefondan yanıtlayın." } }
      }
    },
    "The Android phone no longer has this scheduled message." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "لم تعد هذه الرسالة المجدولة موجودة على هاتف أندرويد." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The Android phone no longer has this scheduled message." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "این پیام زمان‌بندی‌شده دیگر روی گوشی اندرویدی نیست." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bu zamanlanmış mesaj artık Android telefonda yok." } }
      }
    },
    "With a limit, Pairline notifies you at 80% and at 100%, once each month." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "مع تحديد حدّ، ينبّهك Pairline عند 80% وعند 100%، مرة كل شهر." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "With a limit, Pairline notifies you at 80% and at 100%, once each month." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "با تعیین سقف، Pairline هر ماه یک بار در ۸۰٪ و یک بار در ۱۰۰٪ به شما خبر می‌دهد." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bir sınır koyarsanız Pairline her ay bir kez %80’de ve bir kez %100’de sizi bilgilendirir." } }
      }
    },
    "Your Android phone is looking for this iPhone" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "هاتف أندرويد يبحث عن هذا الآيفون" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your Android phone is looking for this iPhone" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "گوشی اندرویدی شما دنبال این آیفون می‌گردد" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefonunuz bu iPhone’u arıyor" } }
      }
    },
    "Your Android phone keeps the message and sends it at this time, even if this iPhone is off or away. Touch and hold it in the conversation to cancel." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتفظ هاتف أندرويد بالرسالة ويرسلها في هذا الوقت حتى لو كان هذا الآيفون مطفأً أو بعيدًا. المسها مطولًا في المحادثة لإلغائها." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your Android phone keeps the message and sends it at this time, even if this iPhone is off or away. Touch and hold it in the conversation to cancel." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "گوشی اندرویدی پیام را نگه می‌دارد و در این زمان می‌فرستد، حتی اگر این آیفون خاموش یا دور باشد. برای لغو، آن را در گفتگو نگه دارید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefonunuz mesajı saklar ve bu iPhone kapalı ya da uzakta olsa bile bu saatte gönderir. İptal etmek için konuşmada mesaja dokunup basılı tutun." } }
      }
    }
  },
  "version" : "1.0"
}
