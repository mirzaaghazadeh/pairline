        "fa" : { "stringUnit" : { "state" : "translated", "value" : "در حال آوردن صدا به این آیفون…" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ses bu iPhone’a aktarılıyor…" } }
