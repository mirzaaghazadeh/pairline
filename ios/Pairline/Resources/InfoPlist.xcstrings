    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Pairline البلوتوث للاتصال بهاتفك الوسيط الذي يعمل بنظام أندرويد، لتتمكن من استخدام شريحة SIM الموجودة فيه على هذا الآيفون."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pairline uses Bluetooth to connect to your Android bridge phone, so you can use its SIM card on this iPhone."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairline از بلوتوث برای اتصال به گوشی پل اندرویدی شما استفاده می‌کند تا بتوانید از سیم‌کارت آن روی این آیفون استفاده کنید."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairline, Android köprü telefonunuzun SIM kartını bu iPhone'da kullanabilmeniz için o telefona Bluetooth ile bağlanır."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Pairline الكاميرا فقط لمسح رمز الإقران الظاهر على هاتفك الوسيط الذي يعمل بنظام أندرويد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Pairline uses the camera only to scan the pairing code shown on your Android bridge phone."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairline فقط برای اسکن کد جفت‌سازی‌ای که روی گوشی پل اندرویدی شما نمایش داده می‌شود، از دوربین استفاده می‌کند."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairline, kamerayı yalnızca Android köprü telefonunuzda gösterilen eşleştirme kodunu taramak için kullanır."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثناء مكالمة تردّ عليها على هذا الآيفون، يرسل Pairline صوتك إلى هاتفك الوسيط الذي يعمل بنظام أندرويد ليسمعك الطرف الآخر. لا يُسجَّل شيء."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "During a call you take on this iPhone, Pairline sends your voice to your Android bridge phone so the other person can hear you. Nothing is recorded."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در تماسی که روی این آیفون جواب می‌دهید، Pairline صدای شما را به گوشی پل اندرویدی‌تان می‌فرستد تا طرف مقابل صدایتان را بشنود. چیزی ضبط نمی‌شود."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu iPhone'da yanıtladığınız bir aramada Pairline, karşı tarafın sizi duyabilmesi için sesinizi Android köprü telefonunuza gönderir. Hiçbir şey kaydedilmez."
          }
        }
      }
    }
  },
  "version" : "1.0"
}