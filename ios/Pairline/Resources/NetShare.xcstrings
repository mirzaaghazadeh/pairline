        "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn on Internet sharing in Pairline Bridge › Settings on your Android phone." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "«اشتراک اینترنت» را در Pairline Bridge › تنظیمات روی گوشی اندرویدی روشن کنید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefonunuzda Pairline Bridge › Ayarlar’dan İnternet paylaşımını açın." } }
