        "en" : { "stringUnit" : { "state" : "translated", "value" : "Username" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "نام کاربری" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kullanıcı adı" } }
