    },
    "Safari and most apps" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "Safari ومعظم التطبيقات" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Safari and most apps" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "Safari و بیشتر برنامه‌ها" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Safari ve çoğu uygulama" } }
      }
    },
    "Server" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الخادم" } },
