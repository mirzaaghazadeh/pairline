        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köprü"
          }
        }
      }
    },
    "The bridge app doesn't support this yet. Update it on your Android phone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يدعم التطبيق الوسيط هذه الميزة بعد. حدّثه على هاتف أندرويد."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه پل هنوز از این قابلیت پشتیبانی نمی‌کند. آن را روی گوشی اندرویدی خود به‌روزرسانی کنید."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köprü uygulaması bunu henüz desteklemiyor. Android telefonunuzda uygulamayı güncelleyin."
          }
        }
      }
    },
    "The bridge app is missing a permission for this. Open Pairline Bridge on your Android phone to allow it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقص التطبيق الوسيط إذنٌ لهذه الميزة. افتح Pairline Bridge على هاتف أندرويد لمنحه الإذن."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه پل مجوز لازم برای این کار را ندارد. برای دادن مجوز، Pairline Bridge را روی گوشی اندرویدی خود باز کنید."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köprü uygulamasında bunun için gereken bir izin eksik. İzin vermek için Android telefonunuzda Pairline Bridge'i açın."
