            "value" : "App Store şu anda kullanılamıyor. Bağlantınızı kontrol edip tekrar deneyin."
          }
        }
      }
    },
    "The bridge" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهاتف الوسيط"
