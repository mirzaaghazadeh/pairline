    },
    "The call couldn't be completed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إتمام المكالمة."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تماس برقرار نشد."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arama tamamlanamadı."
          }
        }
      }
    },
    "The code works once and only for this pairing. Only someone who can see your Android screen can pair." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل الرمز مرة واحدة ولهذا الإقران فقط. ولا يمكن الإقران إلا لمن يستطيع رؤية شاشة هاتف أندرويد."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کد فقط یک بار و فقط برای همین جفت‌سازی کار می‌کند. تنها کسی که صفحه گوشی اندرویدی شما را می‌بیند می‌تواند جفت کند."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod yalnızca bir kez ve yalnızca bu eşleştirme için çalışır. Yalnızca Android ekranınızı görebilen biri eşleştirme yapabilir."
          }
        }
      }
    },
    "The connection dropped while pairing. Try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع الاتصال أثناء الإقران. أعد المحاولة."
