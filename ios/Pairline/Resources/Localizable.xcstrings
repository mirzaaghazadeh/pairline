    },
    "iPhone Recents" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«الأخيرة» على الآيفون"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فهرست «اخیر» آیفون"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone Son Aramalar"
          }
        }
      }
    },
    "iPhone Recents can sync to iCloud, so this is off by default. Calls are always listed in Pairline." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تتزامن قائمة «الأخيرة» على الآيفون مع iCloud، لذا يكون هذا الخيار متوقفًا افتراضيًا. تظهر المكالمات دائمًا في Pairline."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فهرست «اخیر» آیفون ممکن است با iCloud همگام شود، به همین دلیل این گزینه به‌طور پیش‌فرض خاموش است. تماس‌ها همیشه در Pairline فهرست می‌شوند."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone Son Aramalar listesi iCloud ile eşzamanlanabilir, bu yüzden bu seçenek varsayılan olarak kapalıdır. Aramalar Pairline'da her zaman listelenir."
          }
        }
      }
    },
    "Is it a subscription?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل هو اشتراك؟"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آیا اشتراکی است؟"
