    "Android" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أندرويد"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اندروید"
          }
        }
      }
    },
    "Android may stop apps in the background to save battery. These settings keep Pairline Bridge connected all day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يوقف أندرويد التطبيقات العاملة في الخلفية لتوفير البطارية. تُبقي هذه الإعدادات Pairline Bridge متصلًا طوال اليوم."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اندروید ممکن است برای صرفه‌جویی در مصرف باتری، برنامه‌های پس‌زمینه را متوقف کند. این تنظیمات Pairline Bridge را در تمام طول روز متصل نگه می‌دارند."
          }
        }
      }
    },
    "Answer and end calls" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرد على المكالمات وإنهاؤها"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پاسخ دادن و قطع تماس"
