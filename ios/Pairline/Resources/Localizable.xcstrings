        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köprü telefon bunu yapamadı."
          }
        }
      }
    },
    "The bridge phone couldn't handle that request." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على الهاتف الوسيط تنفيذ هذا الطلب."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گوشی پل نتوانست این درخواست را انجام دهد."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köprü telefon bu isteği işleyemedi."
          }
        }
      }
    },
    "The bridge phone couldn't prove it showed this code. Pairing was stopped to keep you safe." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتمكن الهاتف الوسيط من إثبات أنه هو من عرض هذا الرمز، لذا أُوقف الإقران حفاظًا على أمانك."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گوشی پل نتوانست ثابت کند که این کد را خودش نمایش داده است. برای حفظ امنیت شما، جفت‌سازی متوقف شد."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köprü telefon bu kodu kendisinin gösterdiğini kanıtlayamadı. Güvenliğiniz için eşleştirme durduruldu."
          }
        }
      }
    },
    "The bridge phone couldn't use that request." : {
      "extractionState" : "stale",
