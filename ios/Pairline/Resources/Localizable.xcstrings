          }
        }
      }
    },
    "Synced from your bridge phone. Kept only on this iPhone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت مزامنتها من هاتفك الوسيط، وتُحفظ على هذا الآيفون فقط."
          }
        },
        "fa" : {
          "stringUnit" : {
