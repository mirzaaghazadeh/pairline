    },
    "This device has no camera. Use a physical iPhone to scan the pairing code." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي هذا الجهاز على كاميرا. استخدم آيفون حقيقيًا لمسح رمز الإقران."
