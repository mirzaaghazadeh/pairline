        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abonelik mi?"
          }
        }
      }
    },
    "It says the bridge doesn't recognize this iPhone" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر رسالة بأن الهاتف الوسيط لا يتعرّف على هذا الآيفون"
          }
