    "Balance and package codes differ by carrier. Save the ones your carrier uses with the star in the result." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تختلف رموز الرصيد والباقات من مشغّل لآخر. احفظ الرموز التي يستخدمها مشغّلك بالضغط على النجمة في النتيجة."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کدهای موجودی و بسته در هر اپراتور فرق دارد. کدهایی را که اپراتور شما استفاده می‌کند با زدن ستاره کنار نتیجه ذخیره کنید."
          }
        }
      }
    },
    "Balance, packages and carrier services" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرصيد والباقات وخدمات المشغّل"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موجودی، بسته‌ها و خدمات اپراتور"
          }
        }
      }
    },
