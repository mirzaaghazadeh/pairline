    },
    "Install Pairline Bridge on the Android phone that holds your SIM, then scan its pairing code." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت Pairline Bridge على هاتف أندرويد الذي توجد فيه شريحتك، ثم امسح رمز الإقران الذي يعرضه."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairline Bridge را روی گوشی اندرویدی‌ای که سیم‌کارت شما در آن است نصب کنید، سپس کد جفت‌سازی آن را اسکن کنید."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pairline Bridge'i SIM kartınızın takılı olduğu Android telefona yükleyin, ardından eşleştirme kodunu tarayın."
          }
        }
      }
    },
    "Install Pairline Bridge on your Android phone" : {
