        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store در حال حاضر در دسترس نیست. اتصال اینترنت خود را بررسی کنید و دوباره امتحان کنید."
          }
        },
        "tr" : {
          "stringUnit" : {
