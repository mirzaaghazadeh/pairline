    "Turn Bluetooth off and on again on the Android phone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوقف البلوتوث ثم شغّله مجددًا على هاتف أندرويد."
          }
        },
        "fa" : {
          "stringUnit" : {
