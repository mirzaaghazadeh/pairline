            "value" : "يتصل الهاتفان مباشرةً عبر البلوتوث بتشفير تام بين الطرفين."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گوشی‌ها مستقیماً از طریق بلوتوث و با رمزنگاری سرتاسری به هم وصل می‌شوند."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonlar Bluetooth üzerinden doğrudan ve uçtan uca şifreli olarak bağlanır."
