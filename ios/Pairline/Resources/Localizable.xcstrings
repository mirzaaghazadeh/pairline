    },
    "The bridge phone is busy pairing with another device. Try again in a moment." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهاتف الوسيط مشغول بالإقران مع جهاز آخر. أعد المحاولة بعد قليل."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گوشی پل در حال جفت‌سازی با دستگاه دیگری است. چند لحظه دیگر دوباره امتحان کنید."
          }
        },
        "tr" : {
          "stringUnit" : {
