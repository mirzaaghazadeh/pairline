        }
      }
    },
    "The contact is saved in the Android phone's contacts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ جهة الاتصال ضمن جهات الاتصال على هاتف أندرويد."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخاطب در مخاطبین گوشی اندرویدی ذخیره می‌شود."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kişi, Android telefonun kişilerine kaydedilir."
          }
        }
      }
    },
    "The diagnostic log is stored here, has personal details removed, and is shared only if you choose to, after you've seen it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحفظ سجل التشخيص هنا بعد إزالة التفاصيل الشخصية منه، ولا تتم مشاركته إلا إذا اخترت ذلك بعد الاطلاع عليه."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گزارش عیب‌یابی همین‌جا ذخیره می‌شود، اطلاعات شخصی از آن حذف شده و فقط اگر خودتان بخواهید، پس از اینکه آن را دیدید، به اشتراک گذاشته می‌شود."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanılama günlüğü burada saklanır, kişisel bilgilerden arındırılmıştır ve yalnızca siz gördükten sonra paylaşmayı seçerseniz paylaşılır."
          }
        }
      }
    },
    "The free Pairline Bridge app runs on the Android phone with your SIM." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل تطبيق Pairline Bridge المجاني على هاتف أندرويد الذي توجد فيه شريحتك."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه رایگان Pairline Bridge روی گوشی اندرویدی‌ای اجرا می‌شود که سیم‌کارت شما در آن است."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ücretsiz Pairline Bridge uygulaması, SIM kartınızın takılı olduğu Android telefonda çalışır."
          }
        }
      }
    },
    "The iPhone can't find the bridge" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
