    "End-to-end encrypted between your phones. No servers, no accounts, no tracking." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشفير تام بين الطرفين، أي بين هاتفيك. لا خوادم، ولا حسابات، ولا تتبّع."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رمزنگاری سرتاسری بین گوشی‌های شما. بدون سرور، بدون حساب کاربری، بدون ردیابی."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telefonlarınız arasında uçtan uca şifreli. Sunucu yok, hesap yok, izleme yok."
          }
        }
      }
    },
    "Ended" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پایان یافت"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sona erdi"
          }
        }
      }
    },
    "Everything works. Then %@ once to keep it, or it stops connecting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل الميزات تعمل. بعدها ادفع %@ مرة واحدة لتحتفظ به، وإلا سيتوقف عن الاتصال."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "همه امکانات فعال است. سپس با یک بار پرداخت %@ آن را نگه دارید؛ وگرنه دیگر وصل نمی‌شود."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şey çalışır. Ardından kullanmaya devam etmek için bir kez %@ ödeyin; aksi halde bağlantı kurulmaz."
          }
        }
      }
    },
    "Exclude Pairline Bridge from battery optimization on the Android phone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استثنِ Pairline Bridge من تحسين البطارية على هاتف أندرويد."
          }
