            "value" : "Eşleştirme tamamlandı!"
          }
        }
      }
    },
    "Your Android phone and iPhone, linked" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هاتف أندرويد وآيفونك، مترابطان"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گوشی اندرویدی و آیفون شما، متصل به هم"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android telefonunuz ve iPhone'unuz, birbirine bağlı"
          }
        }
      }
    },
    "Your Android phone keeps the SIM. Your iPhone does the talking." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ هاتف أندرويد بالشريحة، ويتولى آيفونك التواصل."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سیم‌کارت در گوشی اندرویدی شما می‌ماند و کارها را با آیفون انجام می‌دهید."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android telefonunuz SIM'i tutar. İletişimi iPhone'unuz üstlenir."
          }
        }
      }
    },
    "Your Android phone keeps the SIM. Your iPhone shows the messages and calls." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الشريحة في هاتف أندرويد، وتظهر الرسائل والمكالمات على آيفونك."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سیم‌کارت در گوشی اندرویدی می‌ماند و پیام‌ها و تماس‌ها روی آیفون شما نمایش داده می‌شوند."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android telefonunuz SIM'i tutar. Mesajları ve aramaları iPhone'unuz gösterir."
          }
        }
      }
    },
    "Your Android SIM on your iPhone. Pay once, keep it for good." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شريحة أندرويد على آيفونك. ادفع مرة واحدة، ويبقى لك إلى الأبد."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سیم‌کارت اندرویدی شما روی آیفونتان. یک بار بپردازید، برای همیشه داشته باشید."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android SIM'iniz iPhone'unuzda. Bir kez ödeyin, sonsuza dek sizin olsun."
          }
        }
      }
    },
    "Your Android SIM, on your iPhone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شريحة أندرويد، على آيفونك."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سیم‌کارت اندرویدی شما، روی آیفونتان."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Android SIM'iniz, iPhone'unuzda."
          }
        }
      }
    },
    "Your bridge app can't answer calls yet. Answer on the Android phone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع التطبيق الوسيط الرد على المكالمات بعد. أجب من هاتف أندرويد."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برنامه پل شما هنوز نمی‌تواند به تماس‌ها پاسخ دهد. با گوشی اندرویدی پاسخ دهید."
          }
        },
        "tr" : {
          "stringUnit" : {
