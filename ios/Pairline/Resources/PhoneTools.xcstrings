        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ringer switch" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "کلید زنگ" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Zil anahtarı" } }
      }
    },
    "Second call" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "مكالمة ثانية" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Second call" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "تماس دوم" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "İkinci arama" } }
