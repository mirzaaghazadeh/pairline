{
  "sourceLanguage" : "en",
  "strings" : {
    "Allow Do Not Disturb access for Pairline Bridge on the Android phone (it shows a notification for it), then try again." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "اسمح بـ«الوصول إلى عدم الإزعاج» لـ Pairline Bridge على هاتف أندرويد (يعرض إشعارًا لذلك)، ثم حاول مرة أخرى." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Do Not Disturb access for Pairline Bridge on the Android phone (it shows a notification for it), then try again." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "روی گوشی اندرویدی «دسترسی به مزاحم نشوید» را برای Pairline Bridge روشن کنید (یک اعلان برایش نشان می‌دهد) و دوباره امتحان کنید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefonda Pairline Bridge’e Rahatsız Etmeyin erişimi verin (bunun için bir bildirim gösterir), sonra yeniden deneyin." } }
      }
    },
    "Android phone's ringer" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "رنين هاتف أندرويد" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Android phone's ringer" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "زنگ گوشی اندرویدی" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefonun zili" } }
      }
    },
    "Audio" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الصوت" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Audio" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "خروجی صدا" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ses" } }
      }
    },
    "Call with Pairline" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "اتصل عبر Pairline" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Call with Pairline" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "تماس با Pairline" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Pairline ile ara" } }
      }
    },
    "Calls a number through your bridge phone's SIM." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتصل برقم عبر شريحة الهاتف الوسيط." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Calls a number through your bridge phone's SIM." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "با سیم‌کارت گوشی پل به یک شماره زنگ می‌زند." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Köprü telefonun SIM’i üzerinden bir numarayı arar." } }
      }
    },
    "Calls show in the Phone app's Recents, where one tap calls back through Pairline. Recents can sync to iCloud: turn this off to keep calls only in Pairline." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تظهر المكالمات في «الأخيرة» في تطبيق الهاتف، حيث تعاود الاتصال عبر Pairline بضغطة واحدة. قد تتزامن «الأخيرة» مع iCloud: أوقف هذا الخيار لإبقاء المكالمات في Pairline فقط." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Calls show in the Phone app's Recents, where one tap calls back through Pairline. Recents can sync to iCloud: turn this off to keep calls only in Pairline." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "تماس‌ها در بخش «اخیر» برنامهٔ Phone نشان داده می‌شوند و با یک ضربه از طریق Pairline دوباره تماس می‌گیرید. «اخیر» ممکن است با iCloud همگام شود: برای اینکه تماس‌ها فقط در Pairline بمانند، این را خاموش کنید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Aramalar Telefon uygulamasının Son Aramalar listesinde görünür; tek dokunuşla Pairline üzerinden geri ararsınız. Son Aramalar iCloud ile eşzamanlanabilir: aramaları yalnızca Pairline’da tutmak için bunu kapatın." } }
      }
    },
    "Edit" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعديل" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Edit" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "ویرایش" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Düzenle" } }
      }
    },
    "Edit Contact" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعديل جهة الاتصال" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Edit Contact" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "ویرایش مخاطب" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kişiyi düzenle" } }
      }
    },
    "Edit contacts from iPhone" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعديل جهات الاتصال من الآيفون" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Edit contacts from iPhone" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "ویرایش مخاطب‌ها از آیفون" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kişileri iPhone’dan düzenle" } }
      }
    },
    "Favourite" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "مفضّلة" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Favourite" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "علاقه‌مندی" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Favori" } }
      }
    },
    "Find phone" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "العثور على الهاتف" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Find phone" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "پیدا کردن گوشی" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Telefonu bul" } }
      }
    },
    "Hold" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعليق" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "نگه‌داشتن" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Beklet" } }
      }
    },
    "Hold calls" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعليق المكالمات" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold calls" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "نگه‌داشتن تماس" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Aramaları beklet" } }
      }
    },
    "It rings loudly for a minute, even on silent. Stop it here or on the Android phone." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يرن بصوت عالٍ لمدة دقيقة، حتى في الوضع الصامت. أوقفه من هنا أو من هاتف أندرويد." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "It rings loudly for a minute, even on silent. Stop it here or on the Android phone." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "یک دقیقه با صدای بلند زنگ می‌زند، حتی روی بی‌صدا. از اینجا یا روی گوشی اندرویدی قطعش کنید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sessizde olsa bile bir dakika yüksek sesle çalar. Buradan ya da Android telefondan durdurun." } }
      }
    },
    "Message" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "رسالة" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Message" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "پیام" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Mesaj" } }
      }
    },
    "Mute" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "كتم" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Mute" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "بی‌صدا کردن" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sessize al" } }
      }
    },
    "Muted" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "مكتوم" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Muted" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "بی‌صدا شده" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sessizde" } }
      }
    },
    "Needs Talk on iPhone on, and the latest Pairline Bridge, on your Android phone. Until then, messages you read here stay unread there." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتطلب تشغيل «التحدث عبر الآيفون» وأحدث إصدار من Pairline Bridge على هاتف أندرويد. وحتى ذلك الحين، تبقى الرسائل التي تقرؤها هنا غير مقروءة هناك." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Needs Talk on iPhone on, and the latest Pairline Bridge, on your Android phone. Until then, messages you read here stay unread there." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "به روشن بودن «مکالمه با آیفون» و آخرین نسخهٔ Pairline Bridge روی گوشی اندرویدی نیاز دارد. تا آن موقع، پیام‌هایی که اینجا می‌خوانید آنجا خوانده‌نشده می‌مانند." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefonunuzda iPhone’dan konuşma’nın açık olması ve en son Pairline Bridge gerekir. O zamana kadar burada okuduğunuz mesajlar orada okunmamış kalır." } }
      }
    },
    "No phone number to call." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يوجد رقم هاتف للاتصال به." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No phone number to call." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "شماره‌ای برای تماس پیدا نشد." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Aranacak telefon numarası yok." } }
      }
    },
    "Number" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الرقم" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Number" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "شماره" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Numara" } }
      }
    },
    "Read on both phones" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "مقروءة على الهاتفين" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Read on both phones" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "خوانده‌شدن روی هر دو گوشی" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "İki telefonda da okundu" } }
      }
    },
    "Reply" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "رد" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Reply" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "پاسخ" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yanıtla" } }
      }
    },
    "Ring the Android phone" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "اجعل هاتف أندرويد يرن" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ring the Android phone" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "به صدا درآوردن گوشی اندرویدی" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefonu çaldır" } }
      }
    },
    "Ring the Android phone, or switch it to silent" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "اجعل هاتف أندرويد يرن، أو حوّله إلى الوضع الصامت" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ring the Android phone, or switch it to silent" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "گوشی اندرویدی را به صدا درآورید یا بی‌صدایش کنید" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefonu çaldırın ya da sessize alın" } }
      }
    },
    "Ringer" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الرنين" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Ringer" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "زنگ" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Zil" } }
