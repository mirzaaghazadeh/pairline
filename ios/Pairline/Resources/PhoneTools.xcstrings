    },
    "Silent" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "صامت" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Silent" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "بی‌صدا" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sessiz" } }
      }
    },
    "Silent needs Do Not Disturb access for Pairline Bridge: the Android phone asks for it the first time." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتطلب الوضع الصامت «الوصول إلى عدم الإزعاج» لـ Pairline Bridge: يطلبه هاتف أندرويد في المرة الأولى." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Silent needs Do Not Disturb access for Pairline Bridge: the Android phone asks for it the first time." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "برای بی‌صدا کردن، Pairline Bridge به «دسترسی به مزاحم نشوید» نیاز دارد: گوشی اندرویدی بار اول آن را می‌خواهد." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sessiz için Pairline Bridge’in Rahatsız Etmeyin erişimi gerekir: Android telefon ilk seferde bunu ister." } }
      }
    },
    "Sound" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "صوت" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sound" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "صدا" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ses" } }
      }
    },
    "Stop ringing" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "إيقاف الرنين" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop ringing" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "قطع زنگ" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Çalmayı durdur" } }
      }
    },
    "Unmute" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "إلغاء الكتم" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Unmute" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "باصدا کردن" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Sesi aç" } }
      }
    },
    "Update Pairline Bridge on your Android phone." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "حدّث Pairline Bridge على هاتف أندرويد." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Update Pairline Bridge on your Android phone." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "Pairline Bridge را روی گوشی اندرویدی به‌روز کنید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefonunuzda Pairline Bridge’i güncelleyin." } }
      }
    },
    "Vibrate" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "اهتزاز" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Vibrate" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "لرزش" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Titreşim" } }
