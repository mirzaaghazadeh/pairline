    },
    "Codes in the Dynamic Island" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الرموز في Dynamic Island" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Codes in the Dynamic Island" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "کدها در Dynamic Island" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Dynamic Island’da kodlar" } }
      }
    },
    "Delete codes after a day" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "حذف الرموز بعد يوم" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete codes after a day" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "پاک کردن کدها بعد از یک روز" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kodları bir gün sonra sil" } }
      }
    },
    "Edit quick replies" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تعديل الردود السريعة" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Edit quick replies" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "ویرایش پاسخ‌های سریع" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hızlı yanıtları düzenle" } }
      }
    },
    "I'll call you back." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "سأعاود الاتصال بك." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "I'll call you back." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "بعداً زنگ می‌زنم." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Seni sonra ararım." } }
      }
    },
    "Messages and alerts" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الرسائل والتنبيهات" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Messages and alerts" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "پیام‌ها و هشدارها" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Mesajlar ve uyarılar" } }
      }
    },
    "New quick reply" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "رد سريع جديد" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "New quick reply" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "پاسخ سریع جدید" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yeni hızlı yanıt" } }
      }
    },
    "No conversations in this group right now." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا توجد محادثات في هذه المجموعة الآن." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No conversations in this group right now." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "فعلاً گفتگویی در این دسته نیست." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şu an bu grupta konuşma yok." } }
      }
    },
    "Nothing here" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا شيء هنا" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Nothing here" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "چیزی اینجا نیست" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Burada bir şey yok" } }
      }
    },
    "Offers" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "العروض" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Offers" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "تبلیغات" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kampanyalar" } }
      }
    },
    "On my way." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "أنا في الطريق." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "On my way." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "در راهم." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Yoldayım." } }
      }
    },
    "One-time codes go from this iPhone 24 hours after they arrive. They stay on the Android phone." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تُحذف الرموز لمرة واحدة من هذا الآيفون بعد 24 ساعة من وصولها، وتبقى على هاتف أندرويد." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "One-time codes go from this iPhone 24 hours after they arrive. They stay on the Android phone." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "کدهای یک‌بارمصرف ۲۴ ساعت بعد از رسیدن از این آیفون پاک می‌شوند و روی گوشی اندرویدی می‌مانند." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tek kullanımlık kodlar geldikten 24 saat sonra bu iPhone’dan silinir. Android telefonda kalırlar." } }
      }
    },
    "People" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الأشخاص" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "People" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "اشخاص" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kişiler" } }
      }
    },
    "Quick replies" : {
