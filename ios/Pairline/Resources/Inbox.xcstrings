    },
    "Services" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الخدمات" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Services" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "خدمات" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Hizmetler" } }
      }
    },
    "Tap the speech bubble next to the message field to put one in. They stay on this iPhone." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "انقر على فقاعة الكلام بجانب حقل الرسالة لإدراج أحدها. تبقى على هذا الآيفون." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Tap the speech bubble next to the message field to put one in. They stay on this iPhone." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "برای گذاشتن یکی از آن‌ها، حباب گفتگو کنار کادر پیام را بزنید. فقط روی همین آیفون می‌مانند." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Birini eklemek için mesaj alanının yanındaki konuşma balonuna dokunun. Bu iPhone’da kalırlar." } }
      }
    },
    "Thanks!" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "شكرًا!" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Thanks!" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "ممنون!" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Teşekkürler!" } }
      }
    },
    "Transactions" : {
