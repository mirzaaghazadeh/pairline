{
  "sourceLanguage" : "en",
  "strings" : {
    "A new code shows there for two minutes, with the bridge status on. Tap it to copy. Never on the Lock Screen." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يظهر الرمز الجديد هناك لمدة دقيقتين عندما تكون حالة الهاتف الوسيط مفعّلة. انقر عليه لنسخه. لا يظهر أبدًا على شاشة القفل." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A new code shows there for two minutes, with the bridge status on. Tap it to copy. Never on the Lock Screen." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "کد تازه، وقتی وضعیت گوشی پل روشن است، دو دقیقه آنجا نشان داده می‌شود. برای کپی رویش بزنید. هیچ‌وقت روی صفحهٔ قفل نمی‌آید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Köprü telefon durumu açıkken yeni bir kod orada iki dakika görünür. Kopyalamak için dokunun. Kilit Ekranı’nda asla görünmez." } }
      }
    },
    "A notification when the Android phone has been out of reach for 5 minutes." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "إشعار عندما يكون هاتف أندرويد بعيدًا عن المتناول لمدة 5 دقائق." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "A notification when the Android phone has been out of reach for 5 minutes." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "وقتی گوشی اندرویدی ۵ دقیقه در دسترس نباشد، یک اعلان می‌آید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefona 5 dakika ulaşılamadığında bir bildirim." } }
      }
    },
    "Add" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "إضافة" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Add" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "افزودن" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Ekle" } }
      }
    },
    "All" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الكل" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "All" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "همه" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tümü" } }
      }
    },
    "Bridge phone left behind" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "نسيان الهاتف الوسيط" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Bridge phone left behind" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "جا ماندن گوشی پل" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Köprü telefon geride kaldı" } }
      }
    },
    "Bridge phone out of reach" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الهاتف الوسيط بعيد عن المتناول" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Bridge phone out of reach" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "گوشی پل در دسترس نیست" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Köprü telefona ulaşılamıyor" } }
      }
    },
    "Calls and texts to your Android phone's SIM can't reach this iPhone. Did you leave it behind?" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا يمكن أن تصل المكالمات والرسائل الواردة إلى شريحة هاتف أندرويد إلى هذا الآيفون. هل نسيته؟" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Calls and texts to your Android phone's SIM can't reach this iPhone. Did you leave it behind?" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "تماس‌ها و پیامک‌های سیم‌کارت گوشی اندرویدی به این آیفون نمی‌رسند. آن را جا گذاشته‌اید؟" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Android telefonunuzun SIM’ine gelen aramalar ve mesajlar bu iPhone’a ulaşamıyor. Telefonu geride mi bıraktınız?" } }
      }
    },
    "Can't talk now. Text me, please." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "لا أستطيع التحدث الآن. راسلني من فضلك." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Can't talk now. Text me, please." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "الان نمی‌توانم صحبت کنم. لطفاً پیام بدهید." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Şu an konuşamıyorum. Lütfen mesaj atın." } }
      }
    },
    "Code copied." : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم نسخ الرمز." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Code copied." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "کد کپی شد." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kod kopyalandı." } }
      }
    },
    "Codes" : {
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الرموز" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Codes" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "کدها" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Kodlar" } }
