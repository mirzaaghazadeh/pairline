        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الردود السريعة" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Quick replies" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "پاسخ‌های سریع" } },
