{
  "sourceLanguage" : "en",
  "strings" : {
    "Buy Cloud mode · %@" : {
      "comment" : "Cloud mode add-on (D-081): the buy button, shown only after Pairline Full Access is bought. %@ is the price, e.g. $9.99.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "شراء الوضع السحابي · %@" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Buy Cloud mode · %@" } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "خرید حالت ابری · %@" } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bulut modunu satın al · %@" } }
      }
    },
    "Pairing over the internet is part of Cloud mode, a one-time %@ add-on to Pairline Full Access." : {
      "comment" : "Cloud mode add-on (D-081): shown instead of pairing over the internet when Full Access is bought but the add-on isn't. %@ is the price.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الإقران عبر الإنترنت جزء من الوضع السحابي، وهو إضافة تُشترى مرة واحدة بسعر %@ إلى الوصول الكامل إلى Pairline." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Pairing over the internet is part of Cloud mode, a one-time %@ add-on to Pairline Full Access." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "جفت کردن از راه اینترنت بخشی از حالت ابری است؛ افزونه‌ای یک‌باره به قیمت %@ برای دسترسی کامل Pairline." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "İnternet üzerinden eşleştirme, Pairline Tam Erişim'e %@ tutarında tek seferlik bir eklenti olan Bulut modunun parçasıdır." } }
      }
    },
    "Cloud mode is a one-time add-on to Pairline Full Access. Everything nearby keeps working without it." : {
      "comment" : "Cloud mode add-on (D-081): Settings footer and the step after pairing, when Full Access is bought but the add-on isn't.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الوضع السحابي إضافة تُشترى مرة واحدة إلى الوصول الكامل إلى Pairline. كل ما يعمل والهاتفان قريبان يظل يعمل من دونها." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cloud mode is a one-time add-on to Pairline Full Access. Everything nearby keeps working without it." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "حالت ابری افزونه‌ای یک‌باره برای دسترسی کامل Pairline است. هر چه وقتی گوشی‌ها کنار هم‌اند کار می‌کند، بدون آن هم کار می‌کند." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bulut modu, Pairline Tam Erişim'e tek seferlik bir eklentidir. Telefonlar yakındayken her şey onsuz da çalışmaya devam eder." } }
      }
    },
    "Cloud mode is part of your free trial. After you buy Pairline, it's a one-time %@ add-on." : {
      "comment" : "Cloud mode add-on (D-081): Settings footer and the step after pairing during the free trial. %@ is the add-on's price.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الوضع السحابي جزء من فترتك التجريبية المجانية. بعد شراء Pairline يصبح إضافة تُشترى مرة واحدة بسعر %@." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cloud mode is part of your free trial. After you buy Pairline, it's a one-time %@ add-on." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "حالت ابری بخشی از دوره آزمایشی رایگان شماست. بعد از خرید Pairline، افزونه‌ای یک‌باره به قیمت %@ است." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bulut modu ücretsiz denemenize dahildir. Pairline'ı satın aldıktan sonra %@ tutarında tek seferlik bir eklentidir." } }
      }
    },
    "Cloud mode needs the free trial or Pairline Full Access." : {
      "comment" : "Cloud mode add-on (D-081): Settings footer when there's no trial running and no Full Access.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يحتاج الوضع السحابي إلى الفترة التجريبية المجانية أو الوصول الكامل إلى Pairline." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cloud mode needs the free trial or Pairline Full Access." } },
        "fa" : { "stringUnit" : { "state" : "translated", "value" : "حالت ابری به دوره آزمایشی رایگان یا دسترسی کامل Pairline نیاز دارد." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Bulut modu için ücretsiz deneme veya Pairline Tam Erişim gerekir." } }
      }
    }
  },
  "version" : "1.0"
}
