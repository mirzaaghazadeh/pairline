    "Talk on iPhone" : {
      "comment" : "D-099: Settings › Connection › Advanced, the header over Call audio. The feature's name everywhere (D-047).",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "التحدث عبر الآيفون" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Talk on iPhone" } },
