      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تصل الرسائل والرموز عبر iCloud الخاص بك. تحتاج المكالمات إلى الاتصال المباشر بمنزلك: راجع «متقدم»." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Texts and codes come through your own iCloud. Calls need the direct connection to your home: see Advanced." } },
