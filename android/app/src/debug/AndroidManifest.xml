<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY (D-018). Merged into the debug manifest; the release APK contains none of this,
     and CI fails if the release APK declares INTERNET (android-policy-check.sh). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The debug TCP transport listens on 127.0.0.1:47800 for the emulator and the iOS Simulator. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Emulator only: `adb emu redir` reaches the Wi-Fi link through the emulator's mobile-data interface, which
         Android keeps as a background network. Binding the media (UDP) socket to it, so replies take the same way
         back, needs this permission. Release builds never use mobile data for the link and don't declare it. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- Pair over the internet (remote pairing, D-092): the live scanner for the iPhone's invitation QR code. Asked
         on the "Scan" tap only; frames are read on the phone and never kept. Debug builds only while the pairing
         screen shows that section only there (release iPhones can't make invitations yet); it moves to the main
         manifest when Cloud mode ships. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- MANAGE_ONGOING_CALLS is now declared by every build (main manifest, D-046). Testers can still grant it by
         hand: `adb shell appops set app.pairline.android.debug MANAGE_ONGOING_CALLS allow`. -->

    <application>
        <!-- Pairing link and state for adb-driven tests. Checks that the caller is adb (shell) itself. -->
        <provider
            android:name=".debugtools.DevToolsProvider"
            android:authorities="${applicationId}.devtools"
            android:exported="true" />
    </application>
</manifest>
