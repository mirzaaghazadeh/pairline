<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Every permission must be listed in docs/PRIVACY.md (AGENTS.md rule 4). -->

    <!-- Network (D-041): the Wi-Fi link to the iPhone on the local network, and the daily update check against
         api.github.com (Settings can turn it off). CI (.github/scripts/network-code-check.sh) fails if any other
         code opens a connection. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Internet sharing (M8): tells whether this phone's traffic goes through a VPN, read locally. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The Wi-Fi link (M5): see which networks are Wi-Fi (the link never listens on mobile data or VPNs). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The bridge hotspot (M5, only when the user starts it): Android's local-only hotspot needs CHANGE_WIFI_STATE,
         plus NEARBY_WIFI_DEVICES on Android 13+ (never used for location) or location on Android 9–12. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32" />

    <!-- Updates (D-042): hands a verified APK to Android's own installer, which always asks the user to confirm.
         Android also asks the user once to allow "Install unknown apps" for Pairline. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The Bluetooth link. Android 11 grants these at install; Android 12+ asks ("Nearby devices"). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- SMS both ways. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- SIMs, calls and USSD. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_COMPANION_APP" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Only to delete call-log entries the user deletes on the iPhone (calllog.delete, D-043). -->
    <uses-permission android:name="android.permission.WRITE_CALL_LOG" />
    <!-- Android 12+ binds the companion call service (keypad, mute, speaker from the iPhone) only for apps holding
         this app-op. Nobody gets it at install: Pairline's helper turns it on only when the user sets up
         "Talk on iPhone" (D-046, D-054). -->
    <uses-permission
        android:name="android.permission.MANAGE_ONGOING_CALLS"
        tools:ignore="ProtectedPermissions" />

    <!-- Contacts: read for caller names and sync; write only when the user turns on "Add contacts from iPhone". -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Keeping the link running. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Cloud mode (D-102): keeps the CPU awake while it checks iCloud every few seconds for what the iPhone sent, so a
         text goes out within seconds with the screen off. Held only while Cloud mode is on and no nearby link is up. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The iPhone's ringer switch (D-074): lists Pairline under Do Not Disturb access, which only the user turns on.
         Needed only to switch to or from silent. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Talk on iPhone (D-059): granted by Pairline's own helper once the user set it up, so Pairline can turn
         Developer options and Wireless debugging back on when the helper is needed again. Never granted otherwise. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Messages scheduled on the iPhone go out at the minute chosen (D-084). Android 12 grants this at install;
         Android 13+ asks the user (Alarms & reminders), and without it the bridge sends as close to the time as Doze
         allows. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- The iPhone's mobile-data meter (D-084): Usage access, which only the user can give in Android Settings, lets
         Pairline read this phone's total mobile data from Android's own statistics. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Photos for the iPhone (D-088, opt-in, off by default): thumbnails and the photos the user taps on the iPhone,
         sent over the Wi-Fi link only. Android asks the user when they turn it on in the bridge app. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Lists the apps on the home screen, so the user can choose whose notifications reach the iPhone (D-077).
         Only launchable apps; no QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- allowBackup="false" and the extraction rules keep messages, contacts and keys out of
         Google cloud backup and device-to-device transfer (AGENTS.md rule 1). -->
    <application
        android:name=".PairlineApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pairline"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Remote pairing (D-092): an invitation from the iPhone, pairline://invite?…. Opening it only shows what
                 it asks for; nothing is sent until the user taps Allow. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pairline" android:host="invite" />
            </intent-filter>
        </activity>

        <!-- The link to the iPhone (BLE GATT server). -->
        <service
            android:name=".link.LinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Companion call service: Android binds it during calls when companion apps are supported.
             The phone's own dialer keeps showing the call. -->
        <service
            android:name=".telephony.PairlineInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_COMPANION"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Pairline's helper hands its binder to the app through this provider. Only the shell or system user can
             call it (INTERACT_ACROSS_USERS_FULL is a signature permission, and the provider checks the caller too).
             D-054. -->
        <provider
            android:name=".privileged.HelperProvider"
            android:authorities="${applicationId}.helper"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- The Wireless debugging pairing code typed into Pairline's notification (D-054). -->
        <receiver
            android:name=".privileged.PairingCodeReceiver"
            android:exported="false" />

        <!-- Notifications from the apps the user chose, mirrored to the iPhone (D-077). Android binds it only after
             the user gives Pairline Bridge notification access in Settings. -->
        <service
            android:name=".mirror.MirrorService"
            android:exported="true"
            android:label="@string/mirror_title"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Find phone's "Stop" (D-074); only this app's own notification can send it. -->
        <receiver
            android:name=".tools.FindPhoneReceiver"
            android:exported="false" />

        <!-- Only the system's SMS stack can send this (BROADCAST_SMS). -->
        <receiver
            android:name=".telephony.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Sent and delivered reports for SMS sent from the iPhone; reached only through our PendingIntents. -->
        <receiver
            android:name=".telephony.SmsResultReceiver"
            android:exported="false" />

        <!-- Call screening (D-085, Android 10+): Android binds it for incoming calls only once the user made Pairline
             Bridge the call-screening app in the system's own dialog (BIND_SCREENING_SERVICE). -->
        <service
            android:name=".telephony.PairlineScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Android's answer for an MMS the iPhone sent (D-089); reached only through our own PendingIntent. -->
        <receiver
            android:name=".telephony.MmsResultReceiver"
            android:exported="false" />

        <!-- The alarm for messages scheduled on the iPhone (D-084); reached only through our own PendingIntent. -->
        <receiver
            android:name=".telephony.ScheduledSmsReceiver"
            android:exported="false" />

        <!-- "Ring my iPhone" in Quick Settings (D-084). Only the system binds it (BIND_QUICK_SETTINGS_TILE). -->
        <service
            android:name=".tools.RingIphoneTile"
            android:exported="true"
            android:icon="@drawable/ic_stat_pairline"
            android:label="@string/ring_iphone_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- "Send to iPhone" in the share sheet (M5): files go to the paired iPhone over the Wi-Fi link. -->
        <activity
            android:name=".files.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:icon="@mipmap/ic_launcher"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Cancel action of a file-transfer notification; reached only through our PendingIntents. -->
        <receiver
            android:name=".files.FileActionReceiver"
            android:exported="false" />

        <!-- Android 9 only: opens received files, which live in Pairline's own Download folder there. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Results of an update's install session; reached only through our own PendingIntent (D-042). -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />

        <receiver
            android:name=".link.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
